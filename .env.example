# Copy to .env and replace every <...> value with a local secret. Do not commit .env.
POSTGRES_DB=cmms
POSTGRES_APP_USER=cmms_app
POSTGRES_APP_PASSWORD=<generate-a-strong-password>

CMMS_JWT_SECRET=<generate-at-least-32-random-characters>
CMMS_INITIAL_ADMIN_USERNAME=admin
CMMS_INITIAL_ADMIN_EMAIL=admin@example.local
CMMS_INITIAL_ADMIN_PASSWORD=<generate-a-strong-password>
# E2E smoke configuration. Export these to the Playwright process; values are never committed.
E2E_BASE_URL=http://localhost:8080
E2E_SMOKE_PASSWORD=<dedicated-non-pilot-password>
E2E_ADMIN_USERNAME=<dedicated-e2e-admin>
E2E_PLANNER_USERNAME=<dedicated-e2e-planner>
E2E_SUPERVISOR_USERNAME=<dedicated-e2e-supervisor>
E2E_TECHNICIAN_USERNAME=<dedicated-e2e-technician>
E2E_VIEWER_USERNAME=<dedicated-e2e-viewer>
E2E_ASSET_CODE=<dedicated-e2e-asset>
E2E_UNIT_CODE=<dedicated-e2e-unit>